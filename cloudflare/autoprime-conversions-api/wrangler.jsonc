{
  "$schema": "../../../node_modules/wrangler/config-schema.json",
  "name": "autoprime-conversions-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "logs": { "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.01 }
  },
  "vars": {
    "META_PIXEL_ID": "1374722030921722",
    "META_GRAPH_API_VERSION": "v25.0",
    "ALLOWED_ORIGINS": "http://autoprime.simulead.com.br,https://autoprime.simulead.com.br,https://marcosviniiciusfs-png.github.io,http://localhost:5173,http://127.0.0.1:5173"
  }
}
